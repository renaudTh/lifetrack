# Self-hosting stack. Copy to .env on the server and fill it in.
# The same values feed the postgres server (POSTGRES_*) and the backend (DB_*):
# one source, so the two cannot drift apart.

DB_HOST=db
DB_PORT=5432
DB_NAME=lifetrack
DB_USERNAME=lifetrack
DB_PASSWORD=change-me

AUTH0_AUDIENCE=lifetrack-api
# The trailing slash is REQUIRED: jwt.strategy.ts concatenates
# `${AUTH0_TENANT}.well-known/jwks.json` and reuses the value as the issuer.
AUTH0_TENANT=https://dev-xxxxxxxx.us.auth0.com/

# Baked into the Angular bundle at build time (docker compose build).
API_URL=https://mon-domaine.example/api
