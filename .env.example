# Stack selfhosting. Copier en .env sur le serveur et remplir.
# Les memes valeurs servent au serveur postgres (POSTGRES_*) et au backend (DB_*) :
# une seule source, pas de derive possible entre les deux.

DB_HOST=db
DB_PORT=5432
DB_NAME=lifetrack
DB_USERNAME=lifetrack
DB_PASSWORD=change-me

AUTH0_AUDIENCE=lifetrack-api
# Le slash final est OBLIGATOIRE : jwt.strategy.ts concatene directement
# `${AUTH0_TENANT}.well-known/jwks.json` et reutilise la valeur comme issuer.
AUTH0_TENANT=https://dev-xxxxxxxx.us.auth0.com/

# Injectee dans le bundle Angular au build (docker compose build).
API_URL=https://mon-domaine.example/api
