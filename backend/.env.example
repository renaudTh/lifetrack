# Environnement de dev (devcontainer). Copier en .env.local.
# Doit correspondre a ce que declare le service `db` de .devcontainer/docker-compose.yaml.

DB_HOST=db
DB_PORT=5432
DB_NAME=lifetrack-dev
DB_USERNAME=lifetrack
DB_PASSWORD=devpass

AUTH0_AUDIENCE=lifetrack-api
# Slash final obligatoire, cf. jwt.strategy.ts
AUTH0_TENANT=https://dev-80v0aoz3uxk711xg.us.auth0.com/
